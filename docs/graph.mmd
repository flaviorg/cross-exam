---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__(<p>__start__</p>)
	extract(extract)
	__error_handler__verify(__error_handler__verify)
	verify(verify)
	collect(collect<hr/><small><em>defer = True</em></small>)
	review(review)
	score(score)
	record(record)
	__end__(<p>__end__</p>)
	__start__ --> extract;
	collect --> review;
	extract -.-> collect;
	extract -.-> verify;
	review --> score;
	score --> record;
	verify --> collect;
	record --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
