# No key at all: cross-exam uses the offline fake examiner (scripted on the demo, a simple
# heuristic elsewhere). Verdicts never need a model: they come from running the checks.

# Anthropic (default examiner when this is set: anthropic:claude-sonnet-5-5)
ANTHROPIC_API_KEY=

# Any LangChain "provider:model" id. --model wins over CROSS_EXAM_MODEL.
# CROSS_EXAM_MODEL=anthropic:claude-sonnet-5-5
# CROSS_EXAM_MODEL=openai:gpt-5.1

# OpenAI or any OpenAI-compatible endpoint
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.example.com/v1

# OpenRouter: CROSS_EXAM_MODEL=openrouter:<vendor>/<model>
# OPENROUTER_API_KEY=

# Stop hook (examples/hooks/stop_hook.py)
# CROSS_EXAM_CRITERIA=.cross-exam/criteria.md
# CROSS_EXAM_BASE=HEAD
